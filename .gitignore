# =========================================================================
# TelegramDrawBot - Git Ignore Rules
# Strictly prevents committing secrets, database files, markdown, and build artifacts
# =========================================================================

# --- 1. Environment & Sensitive Secrets ---
.env
.env.*
.env.local
.env.production
.env.staging
!.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.keystore
*.jks
id_rsa*
id_ed25519*
credentials.json
service-account*.json
token.txt
*token*
*secret*
*credential*
*password*
*.kdbx
*.ovpn
*.session
*.session-journal
session/
sessions/
secrets/
auth/
config.local.*

# --- 2. Database & Data Volumes ---
*.db
*.db-*
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sql
*.dump
*.backup
*.rdb
*.parquet
*.csv
*.tsv
data/
db/
database/
storage/

# --- 3. Markdown & Documentation Files ---
*.md
*.markdown
markdown/
docs/

# --- 4. Dependencies & Package Managers ---
node_modules/
.pnp
.pnp.js

# --- 5. Production Build & TypeScript Cache ---
dist/
build/
*.tsbuildinfo

# --- 6. Logs & Diagnostics ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- 7. Temporary & Scratch Files ---
tmp/
temp/
scratch/
*.tmp
*.temp

# --- 8. OS & IDE Metadata ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
