# =========================================================================
# TelegramDrawBot - Git Ignore Rules
# Strictly prevents committing secrets, database files, and build artifacts
# =========================================================================

# --- 1. Environment & Sensitive Secrets ---
.env
.env.*
.env.local
.env.production
.env.staging
!.env.example
*.pem
*.key
*.cert
*.crt
credentials.json
token.txt
*secret*
*credential*

# --- 2. Database & Data Volumes ---
*.db
*.db-*
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sql
*.dump
*.backup
/data/
/db/

# --- 3. Dependencies & Package Managers ---
node_modules/
.pnp
.pnp.js

# --- 4. Production Build & TypeScript Cache ---
dist/
build/
*.tsbuildinfo

# --- 5. Logs & Diagnostics ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- 6. Temporary & Scratch Files ---
tmp/
temp/
scratch/
*.tmp
*.temp

# --- 7. OS & IDE Metadata ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
